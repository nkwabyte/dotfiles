# ==============================================================================
# OpenSSH Client Configuration
# ==============================================================================

# Global defaults
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 6
  ConnectTimeout 15
  SendEnv LANG LC_*

# Include local machine configuration if present (keys/passwords/local overrides)
Include ~/.ssh/config.local

# ------------------------------------------------------------------------------
# Git Services
# ------------------------------------------------------------------------------

# Personal GitHub (nkwabyte)
Host github-nkwabyte
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

# Personal GitHub (musahibrahimali)
Host github-musahibrahimali
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_babs
    IdentitiesOnly yes

# Work GitHub (DataTrux)
Host github-datatrux
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes

# KNUST GitLab (private instance)
Host gitlab-knust
    HostName git.knust.edu.gh
    User git
    IdentityFile ~/.ssh/id_ed25519_gitlab
    IdentitiesOnly yes

